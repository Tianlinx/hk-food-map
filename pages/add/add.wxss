.add-page {
  height: 100vh;
  padding: 16rpx;
  box-sizing: border-box;
  background: var(--bg);
}

.section {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--brand-2);
}

.loc-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card-2);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 24rpx;
}
.loc-pick-text { font-size: 26rpx; color: var(--muted); flex: 1; }
.loc-pick-btn {
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: var(--on-brand);
  font-weight: 700;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  margin-left: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}
.field:last-child { border-bottom: none; }
.district-field { border-bottom: none; padding-bottom: 8rpx; }
.label { width: 180rpx; font-size: 28rpx; color: var(--muted); flex-shrink: 0; }
.req { color: var(--danger); }
.input, .picker, .textarea {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  background: var(--card-2);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.textarea { height: 160rpx; }

/* 地区 chips */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 8rpx;
}
.chip {
  font-size: 22rpx;
  color: var(--muted);
  background: var(--card-2);
  border: 1rpx solid var(--line);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}
.chip.on { background: linear-gradient(135deg, var(--brand-2), var(--brand)); color: var(--on-brand); font-weight: 700; }

/* 菜系网格 */
.cuisine-grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0 18rpx;
}
.cuisine-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  background: var(--card-2);
  border-radius: 16rpx;
  border: 3rpx solid transparent;
}
.cuisine-item.on { border-color: var(--brand); background: var(--brand-soft); }
.cuisine-icon { width: 80rpx; height: 80rpx; }
.cuisine-text { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }
.cuisine-item.on .cuisine-text { color: var(--brand-2); }

/* 评分 */
.rating-field { border-bottom: none; flex-wrap: wrap; }
.stars { display: flex; }
.star { font-size: 48rpx; color: var(--star-off); margin-right: 10rpx; }
.star.on { color: var(--brand); }
.rating-label {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 600;
}

/* 照片 */
.photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-wrap { position: relative; width: 180rpx; height: 180rpx; }
.photo { width: 180rpx; height: 180rpx; border-radius: 12rpx; }
.photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.7);
  color: var(--brand-2);
  border: 1rpx solid var(--line);
  border-radius: 50%;
  font-size: 30rpx;
}
.photo-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--line);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: var(--muted);
}

.submit { margin: 24rpx 8rpx 40rpx; }

/* 登录横幅 */
.login-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-soft);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
}
.login-tip { font-size: 26rpx; color: var(--brand); flex: 1; }
.login-btn {
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: var(--on-brand);
  font-weight: 700;
  font-size: 24rpx;
  margin: 0 0 0 16rpx;
  line-height: 2;
}
