<scroll-view class="add-page app-root {{themeClass}}" scroll-y>
  <!-- 登录闸门 -->
  <view wx:if="{{!loggedIn}}" class="login-banner">
    <text class="login-tip">发布探店需先微信登录</text>
    <button class="login-btn" size="mini" bindtap="doLogin">微信登录</button>
  </view>

  <!-- 位置 -->
  <view class="section card">
    <view class="section-title">位置 <text class="req">*</text></view>
    <view class="loc-pick" bindtap="chooseLocation">
      <text class="loc-pick-text">{{locationText}}</text>
      <text class="loc-pick-btn">选点</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section card">
    <view class="section-title">基本信息</view>

    <view class="field">
      <text class="label">店名 <text class="req">*</text></text>
      <input class="input" placeholder="例如：兰芳园" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="field district-field">
      <text class="label">地区</text>
      <input class="input" placeholder="可输入或点击下方标签选择" value="{{form.district}}" bindinput="onDistrictInput" />
    </view>
    <view class="chip-wrap">
      <view
        wx:for="{{districts}}"
        wx:key="*this"
        class="chip {{form.district === item ? 'on' : ''}}"
        data-d="{{item}}"
        bindtap="pickDistrict"
      >{{item}}</view>
    </view>

    <view class="field">
      <text class="label">菜系</text>
    </view>
    <view class="cuisine-grid">
      <view
        wx:for="{{cuisines}}"
        wx:key="key"
        class="cuisine-item {{form.cuisine === item.key ? 'on' : ''}}"
        data-k="{{item.key}}"
        bindtap="pickCuisine"
      >
        <image class="cuisine-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="cuisine-text">{{item.key}}</text>
      </view>
    </view>

    <view class="field">
      <text class="label">子项</text>
      <input class="input" placeholder="例如：粤菜、川菜、意大利菜（选填）" value="{{form.cuisine_detail}}" data-field="cuisine_detail" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">人均 (HKD)</text>
      <input class="input" type="digit" placeholder="选填" value="{{form.avgCost}}" data-field="avgCost" bindinput="onInput" />
    </view>

    <view class="field rating-field">
      <text class="label">评分</text>
      <view class="stars">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star {{form.rating >= item ? 'on' : ''}}"
          data-val="{{item}}"
          bindtap="setRating"
        >★</text>
      </view>
      <text wx:if="{{form.rating}}" class="rating-label">{{ratingLabels[form.rating]}}</text>
    </view>
  </view>

  <!-- 推荐菜 & 点评 -->
  <view class="section card">
    <view class="section-title">推荐菜 & 点评</view>
    <view class="field">
      <text class="label">推荐菜</text>
      <input class="input" placeholder="例如：丝袜奶茶、菠萝油（选填）" value="{{form.recommendedDishes}}" data-field="recommendedDishes" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">点评</text>
      <textarea class="textarea" placeholder="说说这次的体验～（选填）" value="{{form.review}}" data-field="review" bindinput="onInput" maxlength="500" />
    </view>
  </view>

  <!-- 封面图 -->
  <view class="section card">
    <view class="section-title">店面封面（选填）</view>
    <view class="photos">
      <view wx:if="{{form.cover}}" class="photo-wrap">
        <image class="photo" src="{{form.cover}}" mode="aspectFill" />
        <text class="photo-del" bindtap="deleteCover">×</text>
      </view>
      <view wx:if="{{!form.cover}}" class="photo-add" bindtap="chooseCover">＋</view>
    </view>
  </view>

  <!-- 照片 -->
  <view class="section card">
    <view class="section-title">照片 ({{form.photos.length}}/{{maxPhotos}})</view>
    <view class="photos">
      <view wx:for="{{form.photos}}" wx:key="*this" class="photo-wrap">
        <image class="photo" src="{{item}}" mode="aspectFill" />
        <text class="photo-del" data-idx="{{index}}" bindtap="deletePhoto">×</text>
      </view>
      <view wx:if="{{form.photos.length < maxPhotos}}" class="photo-add" bindtap="choosePhotos">＋</view>
    </view>
  </view>

  <button class="btn-primary submit" bindtap="submit">{{isEdit ? '保存修改' : '发布到美食地图'}}</button>
</scroll-view>
