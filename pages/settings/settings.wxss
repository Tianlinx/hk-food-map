.page { padding: 24rpx 24rpx 60rpx; }

.sec { padding: 8rpx 28rpx; margin-bottom: 24rpx; }
.sec-title {
  font-size: 26rpx;
  color: var(--brand);
  letter-spacing: 2rpx;
  padding: 24rpx 0 8rpx;
  border-bottom: 1rpx solid var(--line);
}
.row-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}
.row-item:last-child { border-bottom: none; }

.avatar {
  width: 84rpx; height: 84rpx;
  border-radius: 50%;
  background: var(--card-2);
  border: 2rpx solid var(--line);
  flex-shrink: 0;
}
.avatar-empty { display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.acc-info { margin-left: 22rpx; }
.nick { font-size: 32rpx; font-weight: 700; color: var(--text); }
.sub { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }

.label { font-size: 28rpx; color: var(--muted); width: 200rpx; flex-shrink: 0; }
.val { font-size: 28rpx; color: var(--text); flex: 1; word-break: break-all; }
.val.gold { color: var(--brand); }
.mono { font-size: 24rpx; }
.link { color: var(--brand); font-size: 26rpx; padding: 6rpx 20rpx; border: 1rpx solid var(--line); border-radius: 999rpx; }
.arrow { color: var(--muted); font-size: 36rpx; }

/* openid 遮罩 */
.openid-mask { letter-spacing: 1rpx; }
.openid-hint { font-size: 22rpx; color: var(--muted); margin-left: 12rpx; }

/* ===== 主题切换 ===== */
.theme-list { display: flex; flex-direction: column; gap: 16rpx; padding: 16rpx 0; }
.theme-item {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--card-2);
}
.theme-item.on { border-color: var(--brand); background: var(--brand-soft); }
.theme-swatch {
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex; overflow: hidden;
  border: 1rpx solid rgba(0,0,0,.1);
}
.theme-swatch-i { flex: 1; }
.theme-meta { flex: 1; margin-left: 24rpx; }
.theme-name { font-size: 30rpx; font-weight: 700; color: var(--text); }
.theme-desc { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.theme-check { font-size: 36rpx; color: var(--brand); font-weight: 700; }

.foot { text-align: center; color: var(--muted); font-size: 24rpx; padding: 30rpx 0; }
