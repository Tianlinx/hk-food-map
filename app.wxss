/* ===========================================================
   主题系统
   - 每个页面根节点带 class="app-root {{themeClass}}"
   - themeClass 由 app.js 的 globalData.themeClass 注入
   - 下面 4 套主题定义同一组 CSS 变量，切换即换肤
   =========================================================== */

/* 默认（黑金）兜底，写在 page 上，保证变量始终有值 */
page {
  --brand: #c9a96a;
  --brand-2: #e8d4a6;
  --on-brand: #1a1206;
  --bg: #141210;
  --card: #1e1b17;
  --card-2: #2a2620;
  --text: #f0e7d6;
  --muted: #9a8a6b;
  --line: rgba(201, 169, 106, 0.28);
  --line-2: rgba(255, 255, 255, 0.06);
  --brand-soft: rgba(201, 169, 106, 0.12);
  --star-off: #4a4436;
  --danger: #d9746b;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* 黑金（重制：暖炭黑 + 香槟金，更柔和耐看） */
.theme-blackgold {
  --brand: #c9a96a; --brand-2: #e8d4a6; --on-brand: #1a1206;
  --bg: #141210; --card: #1e1b17; --card-2: #2a2620;
  --text: #f0e7d6; --muted: #9a8a6b;
  --line: rgba(201, 169, 106, 0.28); --line-2: rgba(255, 255, 255, 0.06);
  --brand-soft: rgba(201, 169, 106, 0.12); --star-off: #4a4436;
  --danger: #d9746b;
}

/* 薄荷（清透绿 + 米白，护眼浅色） */
.theme-mint {
  --brand: #2f9e7e; --brand-2: #5cb89a; --on-brand: #ffffff;
  --bg: #f3f7f4; --card: #ffffff; --card-2: #eef4f0;
  --text: #1f2a26; --muted: #6f8278;
  --line: rgba(47, 158, 126, 0.22); --line-2: rgba(0, 0, 0, 0.06);
  --brand-soft: rgba(47, 158, 126, 0.10); --star-off: #cdd9d2;
  --danger: #d96b6b;
}

/* 暖阳（暖沙橙 + 奶白，温柔浅色） */
.theme-warm {
  --brand: #e08a3c; --brand-2: #f2b56a; --on-brand: #ffffff;
  --bg: #fbf6ef; --card: #ffffff; --card-2: #f6ede0;
  --text: #3a2e22; --muted: #8a7a66;
  --line: rgba(224, 138, 60, 0.22); --line-2: rgba(0, 0, 0, 0.06);
  --brand-soft: rgba(224, 138, 60, 0.10); --star-off: #e3d6c4;
  --danger: #d9624f;
}

/* 靛蓝（深空蓝 + 雾蓝，沉静深色） */
.theme-indigo {
  --brand: #6b8cff; --brand-2: #9db4ff; --on-brand: #ffffff;
  --bg: #0f1420; --card: #182033; --card-2: #1f293f;
  --text: #e8edf7; --muted: #8794ad;
  --line: rgba(107, 140, 255, 0.30); --line-2: rgba(255, 255, 255, 0.07);
  --brand-soft: rgba(107, 140, 255, 0.12); --star-off: #2b3650;
  --danger: #e07a8a;
}

/* 根容器：铺满视口并吃下主题背景/文字色 */
.app-root { min-height: 100vh; background: var(--bg); color: var(--text); }

/* ===================== 通用类 ===================== */
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: var(--on-brand);
  font-weight: 700;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand);
  border-radius: 999rpx;
  font-size: 28rpx;
}
.btn-ghost::after { border: none; }

.muted { color: var(--muted); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }

/* 通用探店卡片（搜索 / 我的探店 / 收藏 复用） */
.spot-card { border: 1rpx solid var(--line); background: var(--card); border-radius: 16rpx; padding: 20rpx; margin: 16rpx; }
.spot-card .card-main { display: flex; align-items: flex-start; }
.spot-card .card-cover { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; background: var(--card-2); }
.spot-card .card-cover-empty { display: flex; align-items: center; justify-content: center; font-size: 60rpx; }
.spot-card .card-body { flex: 1; padding-left: 20rpx; min-width: 0; }
.spot-card .name { font-size: 32rpx; font-weight: 700; color: var(--text); display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.spot-card .rating-label { font-size: 22rpx; color: var(--brand-2); background: var(--brand-soft); padding: 2rpx 12rpx; border-radius: 999rpx; }
.spot-card .meta { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.spot-card .tag { background: var(--brand-soft); color: var(--brand-2); font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.spot-card .review { font-size: 26rpx; color: var(--muted); margin-top: 12rpx; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.spot-card .stars { color: var(--brand); letter-spacing: 2rpx; }
.spot-card .card-actions { display: flex; gap: 16rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line-2); }
.empty { text-align: center; color: var(--muted); padding: 80rpx 0; font-size: 28rpx; }
.page-head { font-size: 30rpx; font-weight: 700; padding: 24rpx 24rpx 0; }
.search-bar { display: flex; gap: 16rpx; padding: 16rpx; background: var(--card); }
.search-bar input { flex: 1; border: 1rpx solid var(--line); background: var(--card-2); color: var(--text); border-radius: 12rpx; padding: 18rpx; font-size: 28rpx; }
